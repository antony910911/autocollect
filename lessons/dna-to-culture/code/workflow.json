{
  "stages": [
    {
      "n": "1",
      "name": "確認手上的菌是什麼",
      "input": "定序檔",
      "output": "菌種、倍體性、參考基因體",
      "tool": "code/genome_tools.py stats",
      "why": "搞錯菌種，後面全部的工具選擇都是錯的"
    },
    {
      "n": "2",
      "name": "確認基改進去了沒",
      "input": "定序檔 ＋ 構築序列",
      "output": "拷貝數、插入位置、哪個拷貝壞了",
      "tool": "code/case_rt.py",
      "why": "不知道進去幾份，就不知道瓶頸在不在拷貝數"
    },
    {
      "n": "3",
      "name": "拿到功能註解並修正",
      "input": "定序廠的註解包",
      "output": "基因位置檔、鄰居的身分、修過的轉殖基因模型",
      "tool": "code/annotation.py",
      "why": "沒有基因位置檔就不能做 RNA-seq；不修就會算錯"
    },
    {
      "n": "4",
      "name": "把基因變成模型裡的反應",
      "input": "rhto-GEM ＋ 你的基因對照表",
      "output": "可以跑 FBA 的模型",
      "tool": "code/engineered.py",
      "why": "模型是用來「先篩掉不值得做的實驗」的"
    },
    {
      "n": "5",
      "name": "用模型挑要測的條件",
      "input": "模型",
      "output": "一張很短的條件清單",
      "tool": "code/experiments.py",
      "why": "不要一開始就做 20 個搖瓶，先讓模型砍掉一半"
    },
    {
      "n": "6",
      "name": "做第一批實驗",
      "input": "條件清單",
      "output": "生長曲線、殘糖殘氮、油脂、色素、產物、表現量",
      "tool": "本章的操作單",
      "why": "這是整條流程唯一會產生「真實數字」的一步"
    },
    {
      "n": "7",
      "name": "把數據餵回模型",
      "input": "實驗數據",
      "output": "修正過的參數、下一輪的條件",
      "tool": "code/calibrate.py",
      "why": "沒有這一步，模型永遠停在教科書參數"
    }
  ],
